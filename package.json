{
  "name": "conformia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:rls": "vitest run --config vitest.integration.mts",
    "test:e2e": "playwright test",
    "db:migrate": "supabase migration up",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.types.ts",
    "db:reset": "supabase db reset",
    "db:seed": "supabase db execute --file supabase/seed/seed.sql",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --check"
    ],
    "*.{js,mjs,cjs,json,jsonc,css,md}": [
      "prettier --check"
    ]
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "5.101.4",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "next": "15.5.22",
    "next-intl": "4.13.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.3.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
