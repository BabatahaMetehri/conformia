{
  "name": "conformia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:rls": "npm run test:integration",
    "test:integration": "vitest run --config vitest.integration.mts",
    "test:integration:slow": "vitest run --config vitest.integration.mts -t \"@slow\"",
    "db:wait": "node scripts/wait-db.mjs",
    "db:test-env": "supabase db reset && npm run db:wait && npm run db:seed && npm run db:wait",
    "test:integration:fresh": "npm run db:test-env && npm run test:integration",
    "test:e2e": "playwright test",
    "db:migrate": "supabase migration up",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.types.ts.tmp && node -e \"const fs=require('fs');const f='src/types/database.types.ts.tmp';if(fs.statSync(f).size<1000){fs.unlinkSync(f);console.error('Generation des types vide ou tronquee : fichier conserve.');process.exit(1)}fs.renameSync(f,'src/types/database.types.ts')\"",
    "db:reset": "supabase db reset",
    "db:seed": "node scripts/seed.mjs",
    "prepare": "husky",
    "backup": "node scripts/backup.ts",
    "restore": "node scripts/restore.ts",
    "restore:test": "node scripts/restore-test.ts",
    "db:plans": "node scripts/query-plans.ts",
    "load-test": "node scripts/load-test.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --check"
    ],
    "*.{js,mjs,cjs,json,jsonc,css,md}": [
      "prettier --check"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "archiver": "^8.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "3.2.0",
    "exceljs": "^4.4.0",
    "lucide-react": "1.38.0",
    "next": "15.5.22",
    "next-intl": "4.13.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "radix-ui": "^1.6.7",
    "react": "19.1.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "resend": "^6.25.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "fast-check": "^4.9.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.3.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
