# =============================================================================
# CONFORMIA — variables d'environnement
#
# Copier en `.env.local` (ignoré par git) puis renseigner les valeurs.
# Toutes sont validées par Zod dans src/config/env.ts AU CHARGEMENT DU MODULE :
# une variable manquante fait échouer `npm run dev` et `npm run build` en la
# nommant explicitement. Aucune valeur n'est facultative sauf mention contraire.
# =============================================================================

# ─── Public — inliné dans le bundle navigateur. AUCUN SECRET ICI. ─────────────

# URL du projet Supabase. Visible du navigateur, sans danger.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Clé publique « anon ». Ne donne accès qu'à ce que la RLS autorise.
# Si cette clé seule permet de lire une donnée, c'est la policy qui est fautive.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# URL canonique de l'application : redirections d'authentification et liens
# insérés dans les notifications. Sans slash final.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Serveur — secrets. Jamais exposés au navigateur. ─────────────────────────

# development | test | production. Pilote le format des logs et les optimisations.
NODE_ENV="development"

# Clé `service_role` : contourne intégralement la RLS. Usage strictement limité
# aux scripts isolés de src/server/jobs/. Ne doit apparaître dans aucun bundle
# client, aucun log, aucun ticket. Rotation immédiate en cas de fuite.
SUPABASE_SERVICE_ROLE_KEY=""

# Connexion Postgres directe (migrations, jobs de génération d'occurrences).
# Doit commencer par « postgres » — postgres:// ou postgresql://.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Clé Resend — fournisseur d'envoi PAR DÉFAUT des notifications.
# ⚠️ SEULE VARIABLE FACULTATIVE. Le fournisseur est un réglage EN BASE
# (app_settings.email_provider) : une installation basculée sur le SMTP
# d'entreprise n'a aucune raison de détenir une clé Resend, et l'exiger ferait
# échouer son démarrage pour un service qu'elle n'emploie pas. Son absence est
# rattrapée à l'envoi, par une erreur qui nomme cette variable.
RESEND_API_KEY=""

# Serveur SMTP des notifications d'échéance et de relance.
# En développement local : hôte 127.0.0.1, port 54325 (Mailpit, exposé par
# supabase/config.toml). Les messages s'y lisent sur http://127.0.0.1:54324
# et ne quittent jamais la machine.
SMTP_HOST="127.0.0.1"
# Port TCP, 1-65535. Converti en nombre à la validation.
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
# Adresse d'expédition affichée. Doit être une adresse e-mail valide.
SMTP_FROM="conformia@agroespace.dz"

# Secret partagé authentifiant les appels du planificateur vers les Route
# Handlers de cron (génération d'occurrences, relances). 32 caractères minimum.
CRON_SECRET=""

# Chiffre les sauvegardes de documents. 32 caractères minimum.
# ⚠️ Sa perte rend les archives définitivement illisibles : à conserver hors
# de l'application, dans le coffre de l'entreprise.
BACKUP_ENCRYPTION_KEY=""

# Verbosité du logger : debug | info | warn | error. Défaut : info.
LOG_LEVEL="debug"
