# =============================================================================
# CONFORMIA — variables d'environnement
#
# Copier ce fichier en `.env.local` (ignoré par git) et renseigner les valeurs.
# Toute variable listée ici est validée par Zod dans src/config/env.ts.
# Une variable manquante fait échouer le premier accès, pas silencieusement.
# =============================================================================

# --- Public (inliné dans le bundle navigateur — ne jamais y mettre de secret) ---

# URL du projet Supabase. Visible du navigateur, sans danger.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# Clé publique « anon ». Ne donne accès qu'à ce que la RLS autorise.
# Si cette clé seule permet de lire une donnée, la policy est fautive.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# URL canonique de l'application, utilisée pour les redirections d'authentification
# et la construction des liens dans les notifications. Sans slash final.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Serveur uniquement (jamais exposé au navigateur) --------------------------

# development | test | production
NODE_ENV="development"

# Clé `service_role` : contourne la RLS. Usage strictement limité aux scripts
# isolés de src/server/jobs/. Ne doit apparaître dans aucun bundle client,
# aucun log, aucun ticket. Rotation immédiate en cas de fuite.
SUPABASE_SERVICE_ROLE_KEY=""

# Chaîne de connexion Postgres directe. Utile aux migrations et aux jobs de
# génération d'occurrences. Optionnelle en développement local.
SUPABASE_DB_URL=""

# Secret partagé authentifiant les appels du planificateur vers les Route Handlers
# de cron (génération d'occurrences, relances d'échéance). 32 caractères minimum.
CRON_SECRET=""

# Verbosité du logger applicatif : debug | info | warn | error
LOG_LEVEL="debug"
